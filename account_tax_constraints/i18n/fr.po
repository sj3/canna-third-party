#. module: account_tax_constraints
#: model:ir.model,name:account_tax_constraints.model_account_account
msgid "Account"
msgstr "Compte"

#. module: account_tax_constraints
#: model:ir.model,name:account_tax_constraints.model_account_tax
msgid "Tax"
msgstr "Taxe"

#. module: account_tax_constraints
#. odoo-python
#: code:addons/account_tax_constraints/models/account_tax.py:0
msgid ""
"You cannot delete a tax that has been set on Journal Items.\n"
"\n"
"Journal Item IDs: %s"
msgstr ""
"Vous ne pouvez pas supprimer une taxe qui a été définie sur des écritures "
"comptables.\n"
"\n"
"ID des écritures comptables : %s"

#. module: account_tax_constraints
#. odoo-python
#: code:addons/account_tax_constraints/models/account_tax.py:0
msgid ""
"You cannot delete a tax that has been set on product records\n"
"As an alternative, you can disable a tax via the 'active' flag.\n"
"\n"
"Product Template records: %s"
msgstr ""
"Vous ne pouvez pas supprimer une taxe qui a été définie sur des fiches de "
"produit\n"
"À la place, vous pouvez désactiver une taxe via l'option 'active'.\n"
"\n"
"Fiches de modèle de produit : %s"

#. module: account_tax_constraints
#. odoo-python
#: code:addons/account_tax_constraints/models/account_account.py:0
msgid ""
"You cannot delete an account that has been set on tax objects.\n"
"Account: %(account)s\n"
"Tax Object IDs: %(tax_ids)s"
msgstr ""
"Vous ne pouvez pas supprimer un compte qui a été défini sur des objets de "
"taxe.\n"
"Compte : %(account)s\n"
"ID des objets de taxe : %(tax_ids)s"

